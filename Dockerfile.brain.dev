ARG DOCKER_IMAGE=node:24.21.0-alpine
FROM ${DOCKER_IMAGE} AS build-stage

ENV NODE_ENV=development
WORKDIR /app

RUN apk add --no-cache --virtual .build-deps \
  build-base \
  python3 \
  git \
  && apk add --no-cache \
  bash \
  curl \
  && rm -rf /var/cache/apk/*

RUN corepack enable

ENTRYPOINT ["/bin/bash", "-c", "yarn && yarn build && yarn run dev"]
