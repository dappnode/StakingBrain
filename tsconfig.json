{
  "compilerOptions": {
    "target": "ES2023", // Use the latest stable ECMAScript target
    "module": "NodeNext", // Use the latest stable ECMAScript module
    "lib": ["es2023", "dom"],
    "types": ["node", "mocha", "chai"],

    "moduleResolution": "NodeNext",

    "pretty": true,
    "strict": true,
    "sourceMap": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,

    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "preserveWatchOutput": true
  }
}
