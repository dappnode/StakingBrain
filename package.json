{
  "name": "stakingbrain",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.22.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "version": "1.0.0",
  "repository": "https://github.com/dappnode/StakingBrain.git",
  "author": "DappNode Association",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "chai": "^6.3.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "scripts": {
    "build": "yarn workspaces foreach --all -pt run build",
    "test": "yarn workspaces foreach --all -pt run test",
    "dev": "yarn workspaces foreach --all -pi -j unlimited run dev",
    "lint": "eslint 'packages/**/src/**/*.{js,ts,tsx}' 'packages/**/test/**/*.{js,ts,tsx}'",
    "lint:fix": "eslint 'packages/**/src/**/*.{js,ts,tsx}' 'packages/**/test/**/*.{js,ts,tsx}' --fix",
    "format": "prettier --write 'packages/**/src/**/*.{js,ts,tsx,json,md}' 'packages/**/test/**/*.{js,ts,tsx,json,md}'",
    "clean": "yarn run clean:build && yarn run clean:libraries",
    "clean:libraries": "rimraf --glob 'packages/*/node_modules' node_modules",
    "clean:build": "rimraf --glob 'packages/*/dist' 'packages/*/build'",
    "format:check": "prettier --check 'packages/**/src/**/*.{js,ts,tsx,json,md}' 'packages/**/test/**/*.{js,ts,tsx,json,md}'"
  },
  "packageManager": "yarn@4.18.1",
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    }
  }
}
